---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import BreadCrumb from "../../components/ui/BreadCrumb.astro";

const sections = [
  {
    title: "Principal",
    links: [
      { label: "Inicio", href: "/" },
      { label: "Tienda", href: "/tienda" },
      { label: "Sucursales", href: "/sucursales" },
      { label: "Activaciones", href: "/activaciones" },
    ],
  },
  {
    title: "Atención",
    links: [
      { label: "Contáctanos", href: "/contacto" },
      {
        label: "Trabaja con nosotros",
        href: "/trabaja-con-nosotros",
      },
      {
        label: "Libro de Reclamaciones",
        href: "/libro-de-reclamaciones",
      },
    ],
  },
  {
    title: "Nosotros",
    links: [
      {
        label: "Expansion TEC MyT",
        href: "/nosotros",
      },
    ],
  },
  {
    title: "Información",
    links: [
      {
        label: "Política de cookies",
        href: "/politica-cookies",
      },
      {
        label: "Política de privacidad",
        href: "/privacidad",
      },
      {
        label: "Mapa del Sitio",
        href: "/mapa-sitio",
      },
    ],
  },
];
---

<BaseLayout
  title="Mapa del Sitio"
  description="Encuentra rápidamente las principales páginas y secciones del sitio web de Expansion TEC MyT."
>
  <div class="w-full mt-20"></div>

  <main class="container mx-auto max-w-5xl px-4 py-8 sm:py-12">
    <BreadCrumb
      crumbs={[
        { label: "Inicio", href: "/" },
        { label: "Mapa del Sitio" },
      ]}
    />

    <header class="mt-10 max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-red-600">
        Navegación
      </p>

      <h1
        class="mt-3 font-body text-4xl sm:text-5xl font-medium text-gray-900 dark:text-white"
      >
        Mapa del Sitio
      </h1>

      <p class="mt-5 text-lg leading-8 text-gray-600 dark:text-gray-300">
        Encuentra rápidamente las principales secciones de Expansion
        TEC MyT y accede directamente al contenido que estás buscando.
      </p>
    </header>

    <section class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-6">
      {
        sections.map((section) => (
          <article
            class="rounded-3xl border border-gray-200 bg-white p-7 dark:border-gray-800 dark:bg-gray-950"
          >
            <h2
              class="text-xl font-semibold text-gray-900 dark:text-white"
            >
              {section.title}
            </h2>

            <ul class="mt-5 space-y-3">
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="group flex items-center justify-between rounded-xl px-4 py-3 text-gray-600 transition hover:bg-gray-50 hover:text-red-600 dark:text-gray-300 dark:hover:bg-gray-900 dark:hover:text-red-500"
                  >
                    <span>{link.label}</span>

                    <span
                      aria-hidden="true"
                      class="transition-transform group-hover:translate-x-1"
                    >
                      →
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </section>

    <section
      class="mt-12 rounded-3xl bg-gray-100 p-7 dark:bg-gray-900"
    >
      <h2
        class="text-xl font-semibold text-gray-900 dark:text-white"
      >
        ¿No encuentras lo que buscas?
      </h2>

      <p class="mt-2 text-gray-600 dark:text-gray-300">
        Puedes comunicarte con nosotros para recibir más información
        sobre nuestros productos, servicios o sucursales.
      </p>

      <a
        href="/contacto"
        class="mt-5 inline-flex rounded-xl bg-red-600 px-5 py-3 font-semibold text-white transition hover:bg-red-700"
      >
        Ir a contacto
      </a>
    </section>
  </main>
</BaseLayout>