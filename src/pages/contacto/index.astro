---
// src/pages/contacto/index.astro
export const prerender = true;

import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BreadCrumb from "../../components/ui/BreadCrumb.astro";
import Icon from "../../components/ui/Icon.astro";

const locations: CollectionEntry<"locations">[] = await getCollection(
  "locations",
  ({ data }) => data.isActive,
);
---

<BaseLayout
  title="Contacto"
  description="Contáctanos en ExpansionTec. Estamos en Lima con varias sucursales para atenderte."
>
  <div class="w-full mt-20"></div>

  <main class="container mx-auto px-4 py-8 sm:py-12 lg:py-12">
    <BreadCrumb
      crumbs={[{ label: "Inicio", href: "/" }, { label: "Contacto" }]}
    />

    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between mb-8">
      <div>
        <h1
          class="font-body text-3xl md:text-4xl font-medium tracking-tight text-gray-900 dark:text-white"
        >
          Contacto
        </h1>
        <p class="text-sm text-gray-500 mt-2 dark:text-gray-400">
          Escríbenos o visítanos en nuestras sucursales
        </p>
      </div>

      <a
        href="/trabaja-con-nosotros"
        class="inline-flex w-fit items-center justify-center gap-2 rounded-xl bg-gray-900 px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-red-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600 dark:bg-red-600 dark:hover:bg-red-700"
      >
        <Icon name="briefcase" class="w-5 h-5" />
        ¿Quieres trabajar con nosotros?
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Formulario de contacto -->
      <section
        class="bg-white border border-gray-100 rounded-3xl p-7 dark:bg-black dark:border-gray-700"
        aria-labelledby="contact-form-title"
      >
        <h2
          id="contact-form-title"
          class="font-body font-medium text-xl text-gray-700 dark:text-white mb-4"
        >
          Envíanos un mensaje
        </h2>

        <!--
          Reemplaza action con tu endpoint real (API de Astro, Formspree, etc.).
          Sin endpoint, el script intercepta el envío y muestra una explicación,
          en vez de simular que el mensaje fue enviado.
        -->
        <form id="contact-form" class="flex flex-col gap-6" novalidate>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label
                for="name"
                class="font-body text-sm font-medium mb-2 uppercase tracking-wide text-gray-500 dark:text-gray-400"
              >
                Nombre <span aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                placeholder="Tu nombre"
                class="w-full px-4 py-2 rounded-sm border border-red-200 focus:ring-2 focus:ring-red-600/50 text-gray-700 placeholder:text-gray-300 focus:border-red-600 dark:bg-transparent dark:border-red-600 dark:text-white dark:placeholder:text-gray-500"
              />
            </div>
            <div>
              <label
                for="email"
                class="font-body text-sm font-medium mb-2 uppercase tracking-wide text-gray-500 dark:text-gray-400"
              >
                Email <span aria-hidden="true">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                placeholder="tu@email.com"
                class="w-full px-4 py-2 rounded-sm border border-red-200 focus:ring-2 focus:ring-red-600/50 text-gray-700 placeholder:text-gray-300 focus:border-red-600 dark:bg-transparent dark:border-red-600 dark:text-white dark:placeholder:text-gray-500"
              />
            </div>
          </div>

          <div>
            <label
              for="subject"
              class="font-body text-sm font-medium mb-2 uppercase tracking-wide text-gray-500 dark:text-gray-400"
            >
              Asunto
            </label>
            <select
              id="subject"
              name="subject"
              class="w-full px-4 py-2 rounded-sm border border-red-200 focus:ring-2 focus:ring-red-600/50 text-gray-700 focus:border-red-600 dark:bg-transparent dark:border-red-600 dark:text-white"
            >
              <option value="">Selecciona un tema</option>
              <option value="producto">Consulta de producto</option>
              <option value="disponibilidad">Disponibilidad en sucursal</option>
              <option value="precio">Precio y ofertas</option>
              <option value="soporte">Soporte técnico</option>
              <option value="otro">Otro</option>
            </select>
          </div>

          <div>
            <label
              for="message"
              class="font-body text-sm font-medium mb-2 uppercase tracking-wide text-gray-500 dark:text-gray-400"
            >
              Mensaje <span aria-hidden="true">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              placeholder="¿En qué podemos ayudarte?"
              class="w-full px-4 py-2 rounded-sm border border-red-200 focus:ring-2 focus:ring-red-600/50 text-gray-700 placeholder:text-gray-300 focus:border-red-600 dark:bg-transparent dark:border-red-600 dark:text-white dark:placeholder:text-gray-500"
            ></textarea>
          </div>

          <div>
            <label
              for="location"
              class="font-body text-sm font-medium mb-2 uppercase tracking-wide text-gray-500 dark:text-gray-400"
            >
              Sucursal de interés
            </label>
            <select
              id="location"
              name="location"
              class="w-full px-4 py-2 rounded-sm border border-red-200 focus:ring-2 focus:ring-red-600/50 text-gray-700 focus:border-red-600 dark:bg-transparent dark:border-red-600 dark:text-white"
            >
              <option value="">Cualquier sucursal</option>
              {locations.map((loc) => (
                <option value={loc.id}>
                  {loc.data.name} — {loc.data.district}
                </option>
              ))}
            </select>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full text-black py-4 px-6 rounded-xl font-bold flex items-center justify-center gap-2 bg-linear-to-r from-red-300 to-red-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600 cursor-pointer hover:from-red-400 hover:to-red-700 hover:text-black/80 transition-colors duration-300 disabled:cursor-not-allowed disabled:opacity-60"
          >
            Enviar mensaje <span aria-hidden="true">→</span>
          </button>

          <div id="form-feedback" class="hidden" aria-live="polite"></div>
        </form>
      </section>

      <!-- Sucursales -->
      <section class="flex flex-col gap-6" aria-labelledby="stores-title">
        <h2 id="stores-title" class="font-body text-xl font-medium text-gray-700 dark:text-white">
          Nuestras tiendas
        </h2>

        {locations.map((loc) => (
          <a
            href={`/sucursales/${loc.id}`}
            class="group rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600"
            aria-label={`Ver detalles de ${loc.data.name}`}
          >
            <article class="bg-white border border-gray-100 rounded-xl p-4 transition-shadow group-hover:shadow-lg dark:bg-black dark:border-gray-700">
              <p class="font-body text-gray-700 text-base mb-2 font-medium group-hover:text-red-600 transition-colors dark:text-white">
                {loc.data.name}
              </p>
              <p class="font-body text-gray-500 text-sm mb-2 dark:text-white/80">
                <Icon
                  name="location"
                  class="w-5 h-5 inline-block text-red-600 mr-1"
                />
                {loc.data.address}
              </p>
              <p class="font-body text-gray-500 text-sm mb-2 dark:text-white/80">
                <Icon
                  name="phone"
                  class="w-5 h-5 inline-block text-red-600 mr-1"
                />
                {loc.data.phone}
              </p>
              <p class="font-body text-gray-500 text-sm dark:text-white/80">
                <Icon
                  name="clock"
                  class="w-5 h-5 inline-block text-red-600 mr-1"
                />
                {loc.data.schedule}
              </p>
            </article>
          </a>
        ))}
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const button = document.querySelector<HTMLButtonElement>("#submit-btn");
  const feedback = document.querySelector<HTMLElement>("#form-feedback");

  function showFeedback(message: string, type: "success" | "error") {
    if (!feedback) return;
    feedback.className =
      type === "success"
        ? "rounded-lg bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300"
        : "rounded-lg bg-red-50 px-4 py-3 text-sm font-medium text-red-800 dark:bg-red-950/40 dark:text-red-300";
    feedback.textContent = message;
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    // Conecta aquí tu endpoint real. No se simula un éxito para no engañar
    // al usuario con mensajes que no fueron enviados.
    showFeedback(
      "El formulario está listo, pero aún falta configurar el servicio de envío.",
      "error",
    );

    // Ejemplo para un endpoint propio:
    // button!.disabled = true;
    // button!.textContent = "Enviando...";
    // try {
    //   const response = await fetch("/api/contact", {
    //     method: "POST",
    //     body: new FormData(form),
    //   });
    //   if (!response.ok) throw new Error("No se pudo enviar el formulario");
    //   form.reset();
    //   showFeedback("Mensaje enviado. Te contactaremos pronto.", "success");
    // } catch {
    //   showFeedback("No pudimos enviar tu mensaje. Inténtalo nuevamente.", "error");
    // } finally {
    //   button!.disabled = false;
    //   button!.textContent = "Enviar mensaje →";
    // }
  });
</script>
